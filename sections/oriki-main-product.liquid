{%- comment -%} ORÍKÌ product detail — renders the live product {%- endcomment -%}
<div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/collections/all">Shop</a> / {{ product.title }}</div></div>
<section class="sec" style="padding-top:0"><div class="wrap">
  <div class="pdp">
    <div class="pdp-gallery reveal">
      <div class="main">
        {%- if product.tags contains 'Bestseller' or product.tags contains 'Besteller' -%}
          <div class="pdp-badges"><span class="tag" style="background:var(--sage);color:var(--forest);font-size:0.992rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:5px 10px;border-radius:100px">Bestseller</span></div>
        {%- endif -%}
        {%- if product.featured_image -%}
          <img id="pdpMain" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900">
        {%- else -%}
          <img id="pdpMain" src="{{ 'face-800.jpg' | asset_url }}" alt="{{ product.title | escape }}">
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap">
          {%- for image in product.images limit: 6 -%}
            <button type="button" class="pdp-thumb" data-src="{{ image | image_url: width: 900 }}" style="width:66px;height:66px;border-radius:10px;overflow:hidden;border:1px solid var(--line);background:#fff;padding:0;cursor:pointer">
              <img src="{{ image | image_url: width: 130 }}" style="width:100%;height:100%;object-fit:contain" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info reveal">
      <span class="eyebrow">{{ product.type | default: 'Farm to Skin' }}</span>
      <h1>{{ product.title }}</h1>
      <div class="pdp-price" id="pdpPrice">{{ product.selected_or_first_available_variant.price | money }}</div>
      <div class="pdp-rating"><span class="stars">★★★★★</span> Loved by the ORÍKÌ tribe</div>
      {%- if product.description != blank -%}
        <div class="pdp-desc">{{ product.description | strip_html | truncatewords: 42 }}</div>
      {%- endif -%}

      {%- form 'product', product -%}
        {%- if product.variants.size > 1 -%}
          <div style="margin-bottom:14px">
            <label style="font-size:1.28rem;font-weight:600;display:block;margin-bottom:6px">Choose an option</label>
            <select name="id" id="pdpVariant" style="max-width:320px;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;font-family:var(--sans);background:var(--white)">
              {%- for variant in product.variants -%}
                <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <div class="pdp-buy">
          <div class="qty"><button type="button" data-d="-" aria-label="Decrease">−</button><span>1</span><button type="button" data-d="+" aria-label="Increase">+</button></div>
          <input type="hidden" name="quantity" value="1" id="pdpQty">
          <button type="submit" class="btn btn-primary" {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <div class="pdp-assure">
        <div><svg viewBox="0 0 24 24"><path d="M5 19c8 0 14-5 14-14C9 5 5 11 5 19z"/><path d="M5 19c2-5 6-8 10-9"/></svg> 100% Natural</div>
        <div><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.5-9-9C1.5 7 4 4 7 4c2 0 3.5 1.5 5 3 1.5-1.5 3-3 5-3 3 0 5.5 3 4 7-2 4.5-9 9-9 9z"/></svg> Cruelty-Free</div>
        <div><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg> Made in Africa</div>
      </div>

      <div style="margin-top:22px">
        {%- if product.description != blank -%}
          <div class="acc open"><button class="acc-h" type="button">Description<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button><div class="acc-b"><div class="in">{{ product.description }}</div></div></div>
        {%- endif -%}
        <div class="acc"><button class="acc-h" type="button">How to Use<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button><div class="acc-b"><div class="in">Apply as directed, morning and evening, as part of your ORÍKÌ ritual. For best results pair with your ORÍKÌ cleanser and moisturiser.</div></div></div>
        <div class="acc"><button class="acc-h" type="button">Shipping &amp; Returns<svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button><div class="acc-b"><div class="in">Free delivery across Lagos and nationwide on orders over ₦25,000. Unopened items may be returned within 14 days. Available in-store at all ORÍKÌ spa locations.</div></div></div>
      </div>
    </div>
  </div>
</div></section>

{%- assign rel = product.collections.first -%}
{%- if rel and rel.products.size > 1 -%}
<section class="sec" style="background:var(--sand)"><div class="wrap">
  <div class="sec-head reveal"><span class="eyebrow">You may also love</span><h2>Complete the ritual.</h2></div>
  <div class="pgrid reveal">
    {%- assign shown = 0 -%}
    {%- for p in rel.products -%}
      {%- unless p.id == product.id -%}{%- if shown < 4 -%}
        <div class="prod"><div class="ph"><a href="{{ p.url }}">{{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', alt: p.title }}</a></div>
        <div class="pb"><h3><a href="{{ p.url }}">{{ p.title }}</a></h3><span class="price">{{ p.price | money }}</span><a class="btn btn-primary add" href="{{ p.url }}">View Product</a></div></div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endif -%}{%- endunless -%}
    {%- endfor -%}
  </div>
</div></section>
{%- endif -%}

<script>
(function(){
  var main=document.getElementById('pdpMain');
  document.querySelectorAll('.pdp-thumb').forEach(function(t){t.addEventListener('click',function(){ if(main) main.src=t.getAttribute('data-src'); });});
  var span=document.querySelector('.pdp .qty span'), q=document.getElementById('pdpQty');
  if(span&&q){ new MutationObserver(function(){ q.value=(span.textContent||'1').trim(); }).observe(span,{childList:true}); }
  var sel=document.getElementById('pdpVariant'), price=document.getElementById('pdpPrice');
  if(sel&&price){ sel.addEventListener('change',function(){ var o=sel.options[sel.selectedIndex]; if(o&&o.getAttribute('data-price')) price.textContent=o.getAttribute('data-price'); }); }
})();
</script>

{% schema %}
{"name":"ORÍKÌ Product","settings":[]}
{% endschema %}
