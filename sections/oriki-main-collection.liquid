{%- comment -%} ORÍKÌ collection / shop grid — renders live products {%- endcomment -%}
{%- paginate collection.products by 24 -%}
<section class="pagehero" style="min-height:280px">
  {%- if collection.image -%}
    <img class="bg" src="{{ collection.image | image_url: width: 1600 }}" alt="{{ collection.title | escape }}">
  {%- else -%}
    <img class="bg" src="{{ 'wellness-1200.jpg' | asset_url }}" alt="{{ collection.title | escape }}">
  {%- endif -%}
  <div class="inner">
    <span class="eyebrow">Shop ORÍKÌ</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p>{{ collection.description | strip_html | truncatewords: 26 }}</p>{%- endif -%}
  </div>
</section>
<div class="wrap"><div class="crumbs"><a href="/">Home</a> / <a href="/collections/all">Shop</a> / {{ collection.title }}</div></div>

<section class="sec" style="padding-top:12px"><div class="wrap">
  <div class="shopbar reveal">
    <a class="chip{% if collection.handle == 'all' %} on{% endif %}" href="/collections/all">All</a>
    <a class="chip{% if collection.handle == 'skincare' %} on{% endif %}" href="/collections/skincare">Skincare</a>
    <a class="chip{% if collection.handle == 'bath-body' %} on{% endif %}" href="/collections/bath-body">Bath &amp; Body</a>
    <a class="chip{% if collection.handle == 'oriki-for-men' %} on{% endif %}" href="/collections/oriki-for-men">ORÍKÌ for Men</a>
    <a class="chip{% if collection.handle == 'bestsellers' %} on{% endif %}" href="/collections/bestsellers">Bestsellers</a>
  </div>
  <div class="result-count reveal">{{ collection.products_count }} products</div>

  {%- if collection.products.size > 0 -%}
    <div class="pgrid reveal">
      {%- for product in collection.products -%}
        <div class="prod"><div class="ph">
          {%- if product.tags contains 'Bestseller' or product.tags contains 'Besteller' -%}<span class="tag">Bestseller</span>{%- elsif product.available == false -%}<span class="tag" style="background:var(--blush);color:var(--terra-d)">Sold out</span>{%- endif -%}
          <a href="{{ product.url }}">{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', alt: product.title }}</a>
        </div>
        <div class="pb"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><span class="price">{{ product.price | money }}</span>
          <a class="btn btn-primary add" href="{{ product.url }}">View Product</a></div></div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div style="text-align:center;margin-top:34px" class="reveal">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- else -%}
    <p style="color:var(--muted);padding:30px 0">No products here yet. <a href="/collections/all" style="color:var(--terra)">Browse all products →</a></p>
  {%- endif -%}
</div></section>
{%- endpaginate -%}

{% schema %}
{"name":"ORÍKÌ Collection","settings":[]}
{% endschema %}
